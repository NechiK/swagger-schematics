// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Angular custom baseApiPath > accepts a file-path value 1`] = `
"import { Injectable } from "@angular/core";
import { ApiBaseService } from "../core/base/_api-base.service";
import { Observable } from "rxjs";



@Injectable({
  providedIn: 'root',
})
export class DocumentApiService extends ApiBaseService {
  endpoint = 'Document';

  constructor() {
    super();
  }

  /** List documents */
  getDocument({ page, force }: { page?: number; force: boolean }): Observable<boolean> {
    return this.httpClient.get<boolean>(
      this.getUrl('/'),
      { params: { ...(page != null ? { page } : {}), force } }
    );
  }

  /** Download a document */
  getDownloadByDocumentId(documentId: number, { thumbnail }: { thumbnail?: boolean | null } = {}): Observable<Blob> {
    return this.httpClient.get(
      this.getUrl(\`/\${documentId}/download\`),
      { params: { ...(thumbnail != null ? { thumbnail } : {}) }, responseType: 'blob' }
    );
  }

  /** Upload document files */
  postDocumentByDocumentIdUpload(documentId: number, body: FormData): Observable<boolean> {
    return this.httpClient.post<boolean>(
      this.getUrl(\`/\${documentId}/upload\`),
      body
    );
  }
}
"
`;
