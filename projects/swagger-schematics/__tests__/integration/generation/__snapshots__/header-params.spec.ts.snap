exports[`header parameters in generated code Angular: passes headers in the HttpClient options for GET, PUT and DELETE 1`] = `
"import { Injectable } from "@angular/core";
import { ApiBaseService } from "./_api-base.service";
import { Observable } from "rxjs";

import { IOrderDto } from './interfaces/order-dto.interface';

@Injectable({
  providedIn: 'root',
})
export class OrdersApiService extends ApiBaseService {
  endpoint = 'Orders';

  constructor() {
    super();
  }

  getById(id: number, { xTenantId, ifNoneMatch }: { xTenantId: string; ifNoneMatch?: string }): Observable<IOrderDto> {
    return this.httpClient.get<IOrderDto>(
      this.getUrl(\`/\${id}\`),
      { headers: { 'X-Tenant-Id': String(xTenantId), ...(ifNoneMatch != null ? { 'If-None-Match': String(ifNoneMatch) } : {}) } }
    );
  }

  putOrdersById(id: number, body: IOrderDto, { ifMatch, xVersion }: { ifMatch?: string; xVersion?: number | null } = {}): Observable<void> {
    return this.httpClient.put<void>(
      this.getUrl(\`/\${id}\`),
      body,
      { headers: { ...(ifMatch != null ? { 'If-Match': String(ifMatch) } : {}), ...(xVersion != null ? { 'X-Version': String(xVersion) } : {}) } }
    );
  }

  deleteOrdersById(id: number, { idempotencyKey }: { idempotencyKey: string }): Observable<void> {
    return this.httpClient.delete<void>(
      this.getUrl(\`/\${id}\`),
      { headers: { 'Idempotency-Key': String(idempotencyKey) } }
    );
  }

  getOrders({ page }: { page?: number } = {}, { xTrace }: { xTrace?: string } = {}): Observable<IOrderDto[]> {
    return this.httpClient.get<IOrderDto[]>(
      this.getUrl('/'),
      { params: { ...(page != null ? { page } : {}) }, headers: { ...(xTrace != null ? { 'X-Trace': String(xTrace) } : {}) } }
    );
  }
}
"
`;

