import { Injectable } from "@angular/core";
import { ApiBaseService } from "<%= baseApiImportPath %>";
import { Observable } from "rxjs";

<%= transformRefsToImport(importRefs, path, `${path}/${dasherize(name)}-api.service`) %>

@Injectable({
  providedIn: 'root',
})
export class <%= classify(name) %>ApiService extends ApiBaseService {
  endpoint = '<%= name %>';

  constructor() {
    super();
  }
<% for (let item of apiList) {
  let httpCall = buildHttpCall(item);
%>
<%= renderJsDoc(item, '  ') %>  <%= item.apiMethodName %>(<%= item.apiMethodParams %>): Observable<<%= item.responseTypeSymbol %>> {
<% /* Binary responses use the untyped overload: responseType 'blob' in options makes it Observable<Blob> */
   let responseGeneric = item.isBinaryResponse ? '' : `<${item.responseTypeSymbol}>`;
%>    return this.httpClient.<%= httpCall.method %><%= responseGeneric %>(
      <%= httpCall.args.join(',\n      ') %>
    );
  }
<% } %>}
