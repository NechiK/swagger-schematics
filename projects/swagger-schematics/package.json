{
  "name": "swagger-schematics",
  "version": "1.0.0-alpha.9",
  "description": "Schematics types and API generator via Swagger scheme",
  "scripts": {
    "prebuild": "dtsgen --out schema.d.ts **/schema.json",
    "build": "tsc -p tsconfig.schematics.json",
    "pretest": "npm run build",
    "test": "jasmine **/*.spec.js"
  },
  "schematics": "./collection.json",
  "keywords": [
    "schematics",
    "angular",
    "generate"
  ],
  "author": "Maks Nechesonov",
  "license": "ISC",
  "dependencies": {
    "@angular-devkit/core": "15.2.8",
    "@angular-devkit/schematics": "15.2.8",
    "@angular-devkit/schematics-cli": "15.2.8",
    "@schematics/angular": "15.2.8",
    "editorconfig": "2.0.0",
    "axios": "1.6.8"
  },
  "devDependencies": {
    "@types/node": "18.11.9",
    "@types/jasmine": "5.1.4",
    "@types/json-schema": "7.0.15",
    "axios-mock-adapter": "1.22.0",
    "codelyzer": "6.0.2",
    "cpx": "1.5.0",
    "dtsgenerator": "3.19.1",
    "fs-extra": "11.2.0",
    "jasmine": "5.1.0",
    "ts-node": "10.9.2",
    "typescript": "4.7.4"
  }
}
