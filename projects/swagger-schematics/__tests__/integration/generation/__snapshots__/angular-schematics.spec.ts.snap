exports[`Schematics Integration API Service Generation should generate full API service 1`] = `
"import { Injectable } from "@angular/core";
import { ApiBaseService } from "./_api-base.service";
import { Observable } from "rxjs";

import { omitBy, isNil } from 'lodash-es';


import { IClaimDetailDTO } from './interfaces/claim-detail-dto.interface';
import { IClaimNoteViewDTO } from './interfaces/claim-note-view-dto.interface';
import { ICreateNoteDTO } from './interfaces/create-note-dto.interface';
import { ICompanySearchDTO } from './interfaces/company-search-dto.interface';
import { TClaimStatuses } from './enums/claim-statuses.enum';

@Injectable({
  providedIn: 'root',
})
export class ClaimApiService extends ApiBaseService {
  endpoint = 'Claim';

  constructor() {
    super();
  }

  getById(id: number): Observable<IClaimDetailDTO> {
    return this.httpClient.get<IClaimDetailDTO>(
      this.getUrl(\`/\${id}\`)
    );
  }

  updateClaimById(id: number, body: IClaimDetailDTO): Observable<IClaimDetailDTO> {
    return this.httpClient.put<IClaimDetailDTO>(
      this.getUrl(\`/\${id}\`),
      body
    );
  }

  getServiceActionsByClaimId(claimId: number): Observable<IClaimDetailDTO> {
    return this.httpClient.get<IClaimDetailDTO>(
      this.getUrl(\`/\${claimId}/serviceActions\`)
    );
  }

  createClaim({ width, height }: { width?: number; height?: number }, body: FormData): Observable<void> {
    return this.httpClient.post<void>(
      this.getUrl('/'),
      body,
      { params: { width, height } }
    );
  }

  createClaimByIdNote(id: number, body: ICreateNoteDTO): Observable<IClaimNoteViewDTO> {
    return this.httpClient.post<IClaimNoteViewDTO>(
      this.getUrl(\`/\${id}/note\`),
      body
    );
  }

  updateClaimStatus(body: number): Observable<void> {
    return this.httpClient.put<void>(
      this.getUrl('/status'),
      body
    );
  }

  postClaimAll(body: ICompanySearchDTO): Observable<IClaimDetailDTO> {
    return this.httpClient.post<IClaimDetailDTO>(
      this.getUrl('/all'),
      body
    );
  }

  postClaimIds(body: ICompanySearchDTO): Observable<number[]> {
    return this.httpClient.post<number[]>(
      this.getUrl('/ids'),
      body
    );
  }

  updateClaimByIdReactivate(id: number): Observable<void> {
    return this.httpClient.put<void>(
      this.getUrl(\`/\${id}/reactivate\`),
      {}
    );
  }

  deleteClaimDeletemany(body: number[]): Observable<boolean> {
    return this.httpClient.delete<boolean>(
      this.getUrl('/deletemany'),
      { body: body }
    );
  }

  getClaimServiceactions(serviceActionId: number): Observable<number[]> {
    return this.httpClient.get<number[]>(
      this.getUrl('/serviceactions')
    );
  }

  getClaimServiceactionsByServiceActionId(serviceActionId: number): Observable<number[]> {
    return this.httpClient.get<number[]>(
      this.getUrl(\`/serviceactions/\${serviceActionId}\`)
    );
  }

  getClaimBystatus({ id, status }: { id: string; status: TClaimStatuses }): Observable<IClaimDetailDTO[]> {
    return this.httpClient.get<IClaimDetailDTO[]>(
      this.getUrl('/bystatus'),
      { params: { id, status } }
    );
  }

  updateClaimNoteById(body: ICreateNoteDTO): Observable<void> {
    return this.httpClient.put<void>(
      this.getUrl(\`/note/\${body.id}\`),
      body
    );
  }

  deleteClaimSingleById(id: number): Observable<void> {
    return this.httpClient.delete<void>(
      this.getUrl(\`/single/\${id}\`)
    );
  }

  deleteClaimByFilter({ status, force }: { status: string; force?: boolean }): Observable<boolean> {
    return this.httpClient.delete<boolean>(
      this.getUrl('/by-filter'),
      { params: { status, force } }
    );
  }

  getClaimSearch({ name, status, priority }: { name: string; status?: string | null; priority?: number | null }): Observable<IClaimDetailDTO[]> {
    return this.httpClient.get<IClaimDetailDTO[]>(
      this.getUrl('/search'),
      { params: omitBy({ name, status, priority }, isNil) }
    );
  }
}
"
`;

exports[`Schematics Integration Binary Response Support should generate the full binary/multipart API service 1`] = `
"import { Injectable } from "@angular/core";
import { ApiBaseService } from "./_api-base.service";
import { Observable } from "rxjs";

import { omitBy, isNil } from 'lodash-es';




@Injectable({
  providedIn: 'root',
})
export class DocumentApiService extends ApiBaseService {
  endpoint = 'Document';

  constructor() {
    super();
  }

  getDocument({ page, force }: { page?: number; force: boolean }): Observable<boolean> {
    return this.httpClient.get<boolean>(
      this.getUrl('/'),
      { params: { page, force } }
    );
  }

  getDownloadByDocumentId(documentId: number, { thumbnail }: { thumbnail?: boolean | null }): Observable<Blob> {
    return this.httpClient.get(
      this.getUrl(\`/\${documentId}/download\`),
      { params: omitBy({ thumbnail }, isNil), responseType: 'blob' }
    );
  }

  postDocumentByDocumentIdUpload(documentId: number, body: FormData): Observable<boolean> {
    return this.httpClient.post<boolean>(
      this.getUrl(\`/\${documentId}/upload\`),
      body
    );
  }
}
"
`;

