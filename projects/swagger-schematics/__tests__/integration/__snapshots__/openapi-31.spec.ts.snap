exports[`OpenAPI 3.1 support API generation with 3.1 binary responses should generate the service snapshot 1`] = `
"import { Injectable } from "@angular/core";
import { ApiBaseService } from "./_api-base.service";
import { Observable } from "rxjs";

import { omitBy, isNil } from 'lodash-es';


import { IReportDto } from './interfaces/report-dto.interface';

@Injectable({
  providedIn: 'root',
})
export class ReportApiService extends ApiBaseService {
  endpoint = 'Report';

  constructor() {
    super();
  }

  getReport({ filter }: { filter?: string | null }): Observable<IReportDto[]> {
    return this.httpClient.get<IReportDto[]>(
      this.getUrl('/'),
      { params: omitBy({ filter }, isNil) }
    );
  }

  getDownloadByReportId(reportId: number): Observable<Blob> {
    return this.httpClient.get(
      this.getUrl(\`/\${reportId}/download\`),
      { responseType: 'blob' }
    );
  }
}
"
`;

