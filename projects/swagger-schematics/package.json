{
  "name": "swagger-schematics",
  "version": "3.0.0",
  "description": "Generate TypeScript types and API services (Angular HttpClient / RTK Query) from OpenAPI/Swagger schemas",
  "bin": {
    "swagger-schematics": "bin/swagger-schematics.js"
  },
  "scripts": {
    "schema-types": "json2ts -i api/schema.json -o api/schema.d.ts --no-additionalProperties && json2ts -i types/schema.json -o types/schema.d.ts --no-additionalProperties",
    "prebuild": "npm run schema-types",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../../README.md', 'README.md'); require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "build": "tsc -p tsconfig.schematics.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "npm run schema-types && tsc --noEmit -p tsconfig.spec.json",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "compat:generate": "vitest run --config vitest.compat.config.mts",
    "test:update-snapshots": "vitest run --update"
  },
  "schematics": "./collection.json",
  "keywords": [
    "schematics",
    "angular",
    "generate",
    "openapi",
    "swagger",
    "typescript",
    "codegen",
    "code-generation",
    "api-client",
    "rtk-query",
    "react"
  ],
  "author": "Maks Nechesonov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NechiK/swagger-schematics.git"
  },
  "homepage": "https://github.com/NechiK/swagger-schematics#readme",
  "bugs": {
    "url": "https://github.com/NechiK/swagger-schematics/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular-devkit/core": "22.2.1",
    "@angular-devkit/schematics": "22.2.1",
    "@angular-devkit/schematics-cli": "22.2.1",
    "editorconfig": "3.0.2",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.15",
    "@types/node": "26.2.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.8.1",
    "fs-extra": "11.4.0",
    "json-schema-to-typescript": "15.0.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
