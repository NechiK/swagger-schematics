{
  "$schema": "http://json-schema.org/schema",
  "$id": "SwaggerApiSchema",
  "title": "Swagger Api Schema",
  "properties": {
    "path": {
      "type": "string",
      "description": "The path at which to create the files, relative to the current workspace.",
      "visible": false
    },
    "baseApiServicesPath": {
      "type": "string",
      "description": "Path for base API files (if not specified, the path property will be used)."
    },
    "swaggerSchemaUrl": {
      "type": "string",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "apiPathKey": {
      "type": "string"
    },
    "apiServiceTemplatePath": {
      "type": "string"
    },
    "apiCrudServiceTemplatePath": {
      "type": "string"
    }
  },
  "required": []
}
