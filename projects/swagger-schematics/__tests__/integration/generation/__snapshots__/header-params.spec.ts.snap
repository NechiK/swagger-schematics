"
import { api as baseApi } from '@th-common/store/api-base';

import { omitBy, isNil } from 'lodash-es';

import { IOrderDto } from './interfaces/order-dto.interface';

export const ordersApi = baseApi.injectEndpoints({
  overrideExisting: false,
  endpoints: (builder) => ({
    ordersGetById: builder.query<IOrderDto, { id: number; xTenantId: string; ifNoneMatch?: string }>({
      query: ({ id, xTenantId, ifNoneMatch }) => ({
        url: \`/orders/\${id}\`,
        method: 'GET',
        headers: { 'X-Tenant-Id': String(xTenantId), ...(ifNoneMatch != null ? { 'If-None-Match': String(ifNoneMatch) } : {}) },
      }),
    }),
    ordersPutOrdersById: builder.mutation<void, { id: number; ifMatch?: string; xVersion?: number | null; body: IOrderDto }>({
      query: ({ id, ifMatch, xVersion, body }) => ({
        url: \`/orders/\${id}\`,
        method: 'PUT',
        body,
        headers: { ...(ifMatch != null ? { 'If-Match': String(ifMatch) } : {}), ...(xVersion != null ? { 'X-Version': String(xVersion) } : {}) },
      }),
    }),
    ordersDeleteOrdersById: builder.mutation<void, { id: number; idempotencyKey: string }>({
      query: ({ id, idempotencyKey }) => ({
        url: \`/orders/\${id}\`,
        method: 'DELETE',
        headers: { 'Idempotency-Key': String(idempotencyKey) },
      }),
    }),
    ordersGetOrders: builder.query<IOrderDto[], { page?: number; xTrace?: string } | void>({
      query: ({ page, xTrace } = {}) => ({
        url: '/orders',
        method: 'GET',
        params: omitBy({ page }, isNil),
        headers: { ...(xTrace != null ? { 'X-Trace': String(xTrace) } : {}) },
      }),
    }),
  }),
});"
