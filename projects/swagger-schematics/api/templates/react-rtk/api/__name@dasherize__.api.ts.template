<%
// API export name (e.g., "Claim" -> "claimApi", "ReplacementQueue" -> "replacementQueueApi")
let apiExportName = camelize(name) + 'Api';
%>
import { api as baseApi } from '<%= baseApiImportPath %>';
<% if (apiList.some(item => item.hasOmittableQueryParams)) { %>
import { omitBy, isNil } from 'lodash-es';
<% } %>
<% /* Imported as CacheTag: generated type imports always start with I or T (a schema enum 'ApiTag' is TApiTag), so this alias can't clash */
   if (cacheTag) { %>import { TApiTag as CacheTag } from './api-tag.enum';
<% } %><%= transformRefsToImport(importRefs, path, `${path}/${dasherize(name)}.api`) %>

export const <%= apiExportName %> = <%= cacheTag ? `baseApi.enhanceEndpoints({ addTagTypes: [CacheTag.${cacheTag}] })` : 'baseApi' %>.injectEndpoints({
  overrideExisting: false,
  endpoints: (builder) => ({
<% for (let item of apiList) {
  let args = item.apiMethodParamNames.length > 0 ? '{ ' + item.apiMethodParamNames.join(', ') + ' }' : '';
  // All fields optional: the endpoint can be called without an argument (useListQuery())
  let requestType = item.isApiMethodRequestOptional ? item.apiMethodRequestType + ' | void' : item.apiMethodRequestType;
  if (item.isApiMethodRequestOptional) { args += ' = {}'; }
  let builderMethod = item.isQuery ? 'builder.query' : 'builder.mutation';
  let endpointName = scopeEndpointsWithTags ? item.scopedApiMethodName : item.apiMethodName;
  let queryParamsList = item.queryParams.map(p => p.objectSymbol);
  let rawUrl = item.apiUrl ? (dasherize(name) + '/' + item.apiUrl) : dasherize(name);
  let hasInterpolation = rawUrl.includes('${');
  let fullUrl = hasInterpolation ? '`/' + rawUrl + '`' : "'/" + rawUrl + "'";
%><%= renderJsDoc(item, '    ') %>    <%= endpointName %>: <%= builderMethod %><<%= item.responseTypeSymbol %>, <%= requestType %>>({
      query: (<%= args %>) => ({
        url: <%= fullUrl %>,
        method: '<%= item.httpMethod %>',
<% if (item.bodyParam) { %>        <%= item.bodyParam.objectSymbol %>,
<% } if (item.queryParams.length > 0 && item.hasOmittableQueryParams) { %>        params: omitBy({ <%= queryParamsList.join(', ') %> }, isNil),
<% } else if (item.queryParams.length > 0) { %>        params: { <%= queryParamsList.join(', ') %> },
<% } if (item.headerParamsFormatted) { %>        <%= item.headerParamsFormatted %>,
<% } if (item.isBinaryResponse) { %>        responseHandler: (response) => response.blob(),
<% } %>      }),
<% /* GET/HEAD provide the tag, POST/PUT/PATCH/DELETE invalidate it; OPTIONS/TRACE touch no data */
   let tagProperty = !cacheTag ? null : item.isQuery ? 'providesTags' : ['post', 'put', 'patch', 'delete'].includes(item.apiMethodType) ? 'invalidatesTags' : null;
   if (tagProperty) { %>      <%= tagProperty %>: [CacheTag.<%= cacheTag %>],
<% } %>    }),
<% } %>  }),
});