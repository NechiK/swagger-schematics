// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`API generation edge cases (Angular) > response edge cases render consistently in the service 1`] = `
"import { Injectable } from "@angular/core";
import { ApiBaseService } from "./_api-base.service";
import { Observable } from "rxjs";

import { IModelA } from './interfaces/model-a.interface';
import { IModelB } from './interfaces/model-b.interface';

@Injectable({
  providedIn: 'root',
})
export class EdgeCaseApiService extends ApiBaseService {
  endpoint = 'EdgeCase';

  constructor() {
    super();
  }

  /** Bodyless 200 next to a binary 2XX */
  getEdgeCaseDownload(): Observable<Blob> {
    return this.httpClient.get(
      this.getUrl('/download'),
      { responseType: 'blob' }
    );
  }

  /** Response declared only as application/xml */
  getEdgeCaseReport(): Observable<IModelA> {
    return this.httpClient.get<IModelA>(
      this.getUrl('/report')
    );
  }

  /** Response-level $ref */
  getEdgeCaseReferenced(): Observable<IModelB> {
    return this.httpClient.get<IModelB>(
      this.getUrl('/referenced')
    );
  }
}
"
`;
